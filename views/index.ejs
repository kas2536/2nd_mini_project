<%- include("partials/header") %>

<main class="container my-5">
  <!-- header -->
  <div class="row text-center mb-4">
    <div class="col">
      <h1 class="display-5 fw-bold text-primary">🍸 Cocktail Recipe Finder</h1>
      <p class="lead text-secondary">Search for a recipe or get a random drink</p>
    </div>
  </div>

  <!-- search card -->
  <div class="row justify-content-center mb-4">
    <div class="col-md-8">
      <div class="card shadow-sm border-0 p-4">
        <form action="/search" method="POST" class="row g-2">
          <div class="col-sm-8">
            <input 
              type="text" 
              name="drinkName" 
              class="form-control form-control-lg" 
              placeholder="e.g., Margarita, Mojito, Old Fashioned..." 
              required
            >
          </div>
          <div class="col-sm-4 d-grid">
            <button type="submit" class="btn btn-primary btn-lg">Search</button>
          </div>
        </form>

        <div class="text-center my-3 text-muted position-relative">
          <hr>
          <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-uppercase small">or</span>
        </div>

        <div class="d-grid">
          <a href="/random" class="btn btn-outline-secondary btn-lg">Get Random Drink</a>
        </div>
      </div>
    </div>
  </div>

  <!-- error -->
  <% if (error) { %>
    <div class="row justify-content-center mb-4">
      <div class="col-md-8">
        <div class="alert alert-danger alert-dismissible fade show role="alert"">
          <strong>Oops!</strong> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    </div>
  <% } %>

  <!-- display the drink -->
  <% if (drink) { %>
    <div class="row justify-content-center">
      <div class="col-md-10 col-lg-8">
        <div class="card shadow-lg border-0 overflow-hidden">
          <div class="row g-0">
            <!-- picture of drink -->
            <div class="col-md-5">
              <img 
                src="<%= drink.image %>" 
                class="img-fluid h-100 object-fit-cover" 
                alt="<%= drink.name %>"
                style="min-height: 300px;"
              >
            </div>
            <!-- drink info -->
            <div class="col-md-7">
              <div class="card-body p-4">
                <h2 class="card-title text-primary fw-bold mb-3"><%= drink.name %></h2>
                
                <div class="mb-3">
                  <span class="badge bg-primary me-1"><%= drink.category %></span>
                  <span class="badge bg-secondary me-1"><%= drink.alcoholic %></span>
                  <span class="badge bg-info text-dark">Glass: <%= drink.glass %></span>
                </div>

                <h5 class="fw-bold mt-4">Ingredients</h5>
                <ul class="list-group list-group-flush mb-3">
                  <% drink.ingredients.forEach(item => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                      <span><%= item.name %></span>
                      <span class="badge bg-light text-dark border"><%= item.measure %></span>
                    </li>
                  <% }) %>
                </ul>

                <h5 class="fw-bold">Instructions</h5>
                <p class="card-text text-secondary"><%= drink.instructions %></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</main>

<%- include("partials/footer") %>